{
  "name": "claudecodeanalytics",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && vite build",
    "preview": "vite preview",
    "dashboard": "vite build && vite preview --open",
    "docker:up": "docker compose up -d --build",
    "backtest": "node src/collector/backtest/cli.ts",
    "collect": "node src/collector/cli.ts",
    "hook:install": "node src/collector/cli.ts install-hook",
    "lint": "eslint --cache .",
    "lint:fix": "eslint --cache --fix .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-is": "^19.3.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^8.0.0",
    "@eslint-react/eslint-plugin": "^3.0.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.2",
    "eslint": "^10.2.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "jiti": "^2.6.1",
    "jsdom": "^29.0.1",
    "typescript": "~5.9.3",
    "vite": "^8.0.3",
    "vitest": "^4.1.2"
  }
}
