{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Claude Code Analytics Widget",
  "version": "0.0.0",
  "identifier": "local.claudecodeanalytics.widget",
  "build": {
    "beforeDevCommand": "vite --config vite.widget.config.ts",
    "beforeBuildCommand": "vite build --config vite.widget.config.ts",
    "devUrl": "http://localhost:1421",
    "frontendDist": "../dist-widget"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ]
  }
}
